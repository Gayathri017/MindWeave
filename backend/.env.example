# --- Database (Supabase Postgres, "Session pooler" connection string) ---
# Convert the postgresql:// URI Supabase gives you to the asyncpg driver form:
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
# Project Settings -> API Keys -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API Keys -> anon / publishable key (starts with sb_publishable_)
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Gemini API ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
MAX_ITEMS_PER_USER_PER_DAY=50
MAX_CHAT_MESSAGES_PER_USER_PER_DAY=100